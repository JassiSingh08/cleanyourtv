<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <!-- An input tile: "input:<TV input id>|<label>". List ids with `dumpsys tv_input`. -->
        <item>input:com.mediatek.tvinput/.hdmi.HDMIInputService/HDMI300004,com.mediatek.tvinput/.hdmi.HDMIInputService/HW7|PlayStation</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.smartdevice.livetv</item>
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.smartdevice.livetv</string>

    <!-- A spare remote button that switches straight to an input. Find the scan code by watching
         `getevent -lt` while pressing it (KEY_EDIT = 176). 0 turns it off. -->
    <integer name="shortcut_scancode">176</integer>
    <string name="shortcut_input" translatable="false">com.mediatek.tvinput/.hdmi.HDMIInputService/HDMI300004,com.mediatek.tvinput/.hdmi.HDMIInputService/HW7</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>
</resources>
